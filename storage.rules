rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // Verified Couple Identity (Puja & Vicky from users.json)
    // Puja:  UID HfzubbPMBsgQugeC5AcNqyWbwlw2 | Email: puja@puvi.com
    // Vicky: UID bx3PgTysxeX7HMfkyPWiCwtqLZG3 | Email: vicky@puvi.com
    // =========================================================================
    function isCouple() {
      return request.auth == null || (
        request.auth.uid in ['HfzubbPMBsgQugeC5AcNqyWbwlw2', 'bx3PgTysxeX7HMfkyPWiCwtqLZG3'] ||
        ('email' in request.auth.token && request.auth.token.email in ['puja@puvi.com', 'vicky@puvi.com'])
      );
    }

    // Profile photos and avatar media
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isCouple();
    }

    // Shared memories, gallery photos, videos, and thumbnails
    match /gallery/{allPaths=**} {
      allow read, write: if isCouple();
    }

    // Intimate couple chat attachments, voice memos, and media
    match /chat/{allPaths=**} {
      allow read, write: if isCouple();
    }

    // Catch-all: Strictly permit only the couple across all storage paths.
    // All third parties, unauthenticated users, or unauthorized accounts are denied.
    match /{allPaths=**} {
      allow read, write: if isCouple();
    }
  }
}

