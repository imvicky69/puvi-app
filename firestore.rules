rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Verified Couple Identity (Puja & Vicky from users.json)
    // Puja:  UID HfzubbPMBsgQugeC5AcNqyWbwlw2 | Email: puja@puvi.com
    // Vicky: UID bx3PgTysxeX7HMfkyPWiCwtqLZG3 | Email: vicky@puvi.com
    // =========================================================================
    function isCouple() {
      return request.auth != null && (
        request.auth.uid in ['HfzubbPMBsgQugeC5AcNqyWbwlw2', 'bx3PgTysxeX7HMfkyPWiCwtqLZG3'] ||
        ('email' in request.auth.token && request.auth.token.email in ['puja@puvi.com', 'vicky@puvi.com'])
      );
    }

    // Couple root document and relationship metadata
    match /couples/{coupleId} {
      allow read, write: if isCouple();
    }

    // User profile documents (Puja & Vicky)
    match /users/{userId} {
      allow read, write: if isCouple();
    }

    // Timeline milestones
    match /timeline/{milestoneId} {
      allow read, write: if isCouple();
    }

    // Photo gallery & memories
    match /gallery/{photoId} {
      allow read, write: if isCouple();
    }

    // Private couple chat logs
    match /chatMessages/{messageId} {
      allow read, write: if isCouple();
    }

    // Thinking of you & love vibration pings
    match /pings/{pingId} {
      allow read, write: if isCouple();
    }

    // Shared bucket list & travel dreams
    match /bucketList/{itemId} {
      allow read, write: if isCouple();
    }

    // Shared stats (cumulative love count, meet/part timestamps)
    match /shared/{docId} {
      allow read, write: if isCouple();
    }

    // Virtual couple garden watering log
    match /garden/{docId} {
      allow read, write: if isCouple();
    }

    // Real-time daily mood status indicators
    match /moods/{userId} {
      allow read, write: if isCouple();
    }

    // Time apart & distance logs
    match /apartLogs/{logId} {
      allow read, write: if isCouple();
    }

    // Catch-all: Strictly permit only the couple across any document or collection.
    // All third parties, unauthenticated users, or unauthorized accounts are denied.
    match /{document=**} {
      allow read, write: if isCouple();
    }
  }
}

